{
  "name": "paquimetro-para-estudos",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "test": "npm run test:build && npm run test:unit && npm run test:smoke",
    "test:build": "node tests/build-with-retry.mjs",
    "test:unit": "node --experimental-strip-types --test tests/caliper-math.test.mjs tests/caliper-contract.test.mjs tests/caliper-presentation.test.mjs tests/caliper-geometry.test.mjs tests/internal-micrometer-math.test.mjs tests/internal-micrometer-geometry.test.mjs",
    "test:smoke": "node --test tests/rendered-html.test.mjs tests/security-headers.test.mjs tests/build-artifacts.test.mjs",
    "test:ci": "npm run lint && npm test",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.51.3",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "^16.3.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitejs/plugin-rsc": "^0.5.34",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "^19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.67.0",
    "vinext": "^1.0.0-beta.5",
    "vite": "^8.2.1",
    "wrangler": "^4.121.0"
  },
  "type": "module"
}
